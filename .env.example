# Supabase project credentials
# Found at: https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Bunny CDN pull zone hostname (e.g. vz-abc123.b-cdn.net)
VITE_BUNNY_PULL_ZONE=your-pull-zone.b-cdn.net

# Google Gemini API key (for AI features: recommendations, metadata, captions)
# Get one at: https://aistudio.google.com/app/apikey
VITE_API_KEY=your-gemini-api-key

# Admin access — comma-separated list of authorised emails and phone numbers
# Phone numbers must be in E.164 format (+2547XXXXXXXX)
VITE_ADMIN_EMAILS=admin@yourdomain.com
VITE_ADMIN_PHONES=+254700000000

# VAPID public key for Web Push notifications (generate with: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
